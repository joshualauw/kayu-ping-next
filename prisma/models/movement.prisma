model Movement {
  id               Int      @id @default(autoincrement())
  tid              String   @unique
  truckerId        Int      @map("trucker_id")
  movementDate     DateTime @map("movement_date") @db.Timestamptz(6)
  fromLocationId   Int      @map("from_location_id")
  toLocationId     Int      @map("to_location_id")
  notes            String?
  totalMovedVolume Float    @map("total_moved_volume")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items        MovementItem[]
  fromLocation Location       @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("ToLocation", fields: [toLocationId], references: [id])
  trucker      Contact        @relation(fields: [truckerId], references: [id])

  @@map("movements")
}

model MovementItem {
  id            Int  @id @default(autoincrement())
  movementId    Int  @map("movement_id")
  gradeId       Int? @map("grade_id")
  woodVariantId Int  @map("wood_variant_id")
  lotId         Int  @map("lot_id")
  quantity      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade    Grade?      @relation(fields: [gradeId], references: [id])
  movement Movement    @relation(fields: [movementId], references: [id])
  variant  WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot      Lot         @relation(fields: [lotId], references: [id])

  @@map("movement_items")
}
