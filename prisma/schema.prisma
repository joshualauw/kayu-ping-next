generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  email    String @unique
  password String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Wood {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  code String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants WoodVariant[]

  @@map("woods")
}

model Contact {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  phoneNumber String? @unique @db.VarChar(255)
  email       String? @unique @db.VarChar(255)
  address     String?
  notes       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  type      ContactType
  movements Movement[]
  purchases Purchase[]
  sales     Sale[]

  @@map("contacts")
}

model Location {
  id      Int          @id @default(autoincrement())
  name    String       @db.VarChar(255)
  address String?
  type    LocationType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  gradings       Grading[]
  inventories    Inventory[]
  movementsFrom  Movement[]      @relation("FromLocation")
  movementsTo    Movement[]      @relation("ToLocation")
  processings    Processing[]
  purchases      Purchase[]
  sales          Sale[]
  stockMutations StockMutation[]
  adjustments    Adjustment[]

  @@map("locations")
}

model Material {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  measurement Measurement
  variants    WoodVariant[]

  @@map("materials")
}

model WoodVariant {
  id            Int    @id @default(autoincrement())
  woodId        Int    @map("wood_id")
  materialId    Int    @map("material_id")
  width         Float?
  height        Float?
  diameterSmall Float? @map("diameter_small")
  diamterLarge  Float? @map("diameter_large")
  length        Float?
  volume        Float

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  gradingItems    GradingItem[]
  inventories     Inventory[]
  movementItems   MovementItem[]
  processingItems ProcessingItem[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  mutations       StockMutation[]
  material        Material         @relation(fields: [materialId], references: [id])
  wood            Wood             @relation(fields: [woodId], references: [id])
  adjustmentItems AdjustmentItem[]

  @@map("wood_variants")
}

model Grade {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  code String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventories     Inventory[]
  stockMutations  StockMutation[]
  gradingItems    GradingItem[]
  movementItems   MovementItem[]
  processingItems ProcessingItem[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  adjustmentItems AdjustmentItem[]

  @@map("grades")
}

model Lot {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventories     Inventory[]
  stockMutations  StockMutation[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  processingItems ProcessingItem[]
  movementItems   MovementItem[]
  gradingItems    GradingItem[]
  adjustmentItems AdjustmentItem[]

  @@map("lots")
}

model Inventory {
  id            Int  @id @default(autoincrement())
  woodVariantId Int  @map("wood_variant_id")
  gradeId       Int? @map("grade_id")
  lotId         Int  @map("lot_id")
  locationId    Int  @map("location_id")
  stock         Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade    Grade?      @relation(fields: [gradeId], references: [id])
  location Location    @relation(fields: [locationId], references: [id])
  lot      Lot         @relation(fields: [lotId], references: [id])
  variant  WoodVariant @relation(fields: [woodVariantId], references: [id])

  @@map("inventories")
}

model StockMutation {
  id            Int           @id @default(autoincrement())
  mutationDate  DateTime      @map("mutation_date") @db.Timestamptz(6)
  woodVariantId Int           @map("wood_variant_id")
  gradeId       Int?          @map("grade_id")
  lotId         Int           @map("lot_id")
  locationId    Int           @map("location_id")
  type          MutationType
  quantity      Int
  referenceType ReferenceType @map("reference_type")
  referenceId   Int           @map("reference_id")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade    Grade?      @relation(fields: [gradeId], references: [id])
  location Location    @relation(fields: [locationId], references: [id])
  lot      Lot         @relation(fields: [lotId], references: [id])
  variant  WoodVariant @relation(fields: [woodVariantId], references: [id])

  @@map("stock_mutations")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  tid          String   @unique
  supplierId   Int      @map("supplier_id")
  locationId   Int      @map("location_id")
  purchaseDate DateTime @map("purchase_date") @db.Timestamptz(6)
  notes        String?
  totalPrice   Float    @map("total_price")
  totalVolume  Float    @map("total_volume")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    PurchaseItem[]
  location Location       @relation(fields: [locationId], references: [id])
  supplier Contact        @relation(fields: [supplierId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id            Int   @id @default(autoincrement())
  purchaseId    Int   @map("purchase_id")
  gradeId       Int?  @map("grade_id")
  woodVariantId Int   @map("wood_variant_id")
  lotId         Int   @map("lot_id")
  pricePerCubic Float @map("price_per_cubic")
  quantity      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade    Grade?      @relation(fields: [gradeId], references: [id])
  purchase Purchase    @relation(fields: [purchaseId], references: [id])
  variant  WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot      Lot         @relation(fields: [lotId], references: [id])

  @@map("purchase_items")
}

model Sale {
  id          Int      @id @default(autoincrement())
  tid         String   @unique
  saleDate    DateTime @map("sale_date") @db.Timestamptz(6)
  customerId  Int      @map("customer_id")
  locationId  Int      @map("location_id")
  notes       String?
  totalVolume Float    @map("total_volume")
  totalPrice  Float    @map("total_price")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    SaleItem[]
  customer Contact    @relation(fields: [customerId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])

  @@map("sales")
}

model SaleItem {
  id            Int   @id @default(autoincrement())
  saleId        Int   @map("sale_id")
  gradeId       Int?  @map("grade_id")
  woodVariantId Int   @map("wood_variant_id")
  lotId         Int   @map("lot_id")
  pricePerCubic Float @map("price_per_cubic")
  quantity      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade   Grade?      @relation(fields: [gradeId], references: [id])
  sale    Sale        @relation(fields: [saleId], references: [id])
  variant WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot     Lot         @relation(fields: [lotId], references: [id])

  @@map("sale_items")
}

model Processing {
  id                Int      @id @default(autoincrement())
  tid               String   @unique
  processingDate    DateTime @map("processing_date") @db.Timestamptz(6)
  locationId        Int      @map("location_id")
  notes             String?
  totalInputVolume  Float    @map("total_input_volume")
  totalOutputVolume Float    @map("total_output_volume")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  location Location         @relation(fields: [locationId], references: [id])
  items    ProcessingItem[]

  @@map("processing")
}

model ProcessingItem {
  id            Int            @id @default(autoincrement())
  processingId  Int            @map("processing_id")
  gradeId       Int?           @map("grade_id")
  woodVariantId Int            @map("wood_variant_id")
  lotId         Int            @map("lot_id")
  type          ProcessingType
  quantity      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade      Grade?      @relation(fields: [gradeId], references: [id])
  processing Processing  @relation(fields: [processingId], references: [id])
  variant    WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot        Lot         @relation(fields: [lotId], references: [id])

  @@map("processing_items")
}

model Movement {
  id               Int      @id @default(autoincrement())
  tid              String   @unique
  truckerId        Int      @map("trucker_id")
  movementDate     DateTime @map("movement_date") @db.Timestamptz(6)
  fromLocationId   Int      @map("from_location_id")
  toLocationId     Int      @map("to_location_id")
  notes            String?
  totalMovedVolume Float    @map("total_moved_volume")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items        MovementItem[]
  fromLocation Location       @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("ToLocation", fields: [toLocationId], references: [id])
  trucker      Contact        @relation(fields: [truckerId], references: [id])

  @@map("movements")
}

model MovementItem {
  id            Int  @id @default(autoincrement())
  movementId    Int  @map("movement_id")
  gradeId       Int? @map("grade_id")
  woodVariantId Int  @map("wood_variant_id")
  lotId         Int  @map("lot_id")
  quantity      Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade    Grade?      @relation(fields: [gradeId], references: [id])
  movement Movement    @relation(fields: [movementId], references: [id])
  variant  WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot      Lot         @relation(fields: [lotId], references: [id])

  @@map("movement_items")
}

model Grading {
  id          Int      @id @default(autoincrement())
  tid         String   @unique
  gradingDate DateTime @map("grading_date") @db.Timestamptz(6)
  locationId  Int      @map("location_id")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    GradingItem[]
  location Location      @relation(fields: [locationId], references: [id])

  @@map("gradings")
}

model GradingItem {
  id            Int         @id @default(autoincrement())
  gradingId     Int         @map("grading_id")
  gradeId       Int?        @map("grade_id")
  woodVariantId Int         @map("wood_variant_id")
  lotId         Int         @map("lot_id")
  type          GradingType
  quantity      Int
  comment       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade   Grade?      @relation(fields: [gradeId], references: [id])
  grading Grading     @relation(fields: [gradingId], references: [id])
  variant WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot     Lot         @relation(fields: [lotId], references: [id])

  @@map("grading_items")
}

model Adjustment {
  id             Int      @id @default(autoincrement())
  tid            String   @unique
  adjustmentDate DateTime @map("adjustment_date") @db.Timestamptz(6)
  locationId     Int      @map("location_id")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  location Location         @relation(fields: [locationId], references: [id])
  items    AdjustmentItem[]

  @@map("adjustments")
}

model AdjustmentItem {
  id            Int              @id @default(autoincrement())
  adjustmentId  Int              @map("adjustment_id")
  gradeId       Int?             @map("grade_id")
  woodVariantId Int              @map("wood_variant_id")
  lotId         Int              @map("lot_id")
  quantity      Int
  type          AdjustmentType
  reason        AdjustmentReason
  comment       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  grade      Grade?      @relation(fields: [gradeId], references: [id])
  adjustment Adjustment  @relation(fields: [adjustmentId], references: [id])
  variant    WoodVariant @relation(fields: [woodVariantId], references: [id])
  lot        Lot         @relation(fields: [lotId], references: [id])

  @@map("adjustment_items")
}

model Fee {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(255)
  price         Float
  referenceId   Int           @map("reference_id")
  referenceType ReferenceType @map("reference_type")

  @@map("fees")
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  TRUCKER
  OTHERS

  @@map("contact_types")
}

enum LocationType {
  WAREHOUSE
  PORT
  MILL
  OTHERS

  @@map("location_types")
}

enum Measurement {
  CYLINDER
  CUBE

  @@map("measurements")
}

enum ProcessingType {
  INPUT
  OUTPUT

  @@map("processing_types")
}

enum GradingType {
  BEFORE
  AFTER

  @@map("grading_types")
}

enum AdjustmentType {
  ADD
  SUBTRACT

  @@map("adjustment_types")
}

enum AdjustmentReason {
  LOST
  FOUND
  DAMAGE
  OTHERS

  @@map("adjustment_reasons")
}

enum MutationType {
  IN
  OUT

  @@map("mutation_types")
}

enum ReferenceType {
  PURCHASE
  SALES
  ADJUSTMENT
  PROCESSING
  MOVEMENT
  GRADING

  @@map("reference_types")
}
